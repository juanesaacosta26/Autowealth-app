# =====================================================================
#  CONFIGURACIÓN DE AUTO-WEALTH
#  1. Copia este archivo y llámalo .env   (en PowerShell: copy .env.example .env)
#  2. Llena los valores. NUNCA compartas ni subas el archivo .env a internet.
#  En Render estos mismos valores se ponen en "Environment" (no se sube el .env).
# =====================================================================

# Puerto local. Déjalo así. (Render lo asigna solo)
PORT=3000

# "development" en tu computador, "production" en Render
NODE_ENV=development

# --- BASE DE DATOS (Neon) -------------------------------------------
# Neon → tu proyecto → botón "Connect" → copia la "Connection string" completa
DATABASE_URL=postgresql://usuario:contraseña@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# --- SESIONES --------------------------------------------------------
# Una clave larga y secreta (mínimo 32 caracteres). Para generarla, ejecuta:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=cambia-esto-por-una-clave-larga-y-aleatoria-de-mas-de-32-caracteres

# --- ENCUESTA --------------------------------------------------------
SURVEY_URL=https://forms.gle/q7PYdBcBk3SMQzUPA

# --- CORREO ----------------------------------------------------------
# "consola" = no envía correos, solo los muestra en la terminal (para probar)
# "gmail"   = envía desde tu Gmail real con un Apps Script (llega mejor a Principal, máx. 100/día)
# "brevo"   = envía con Brevo (máx. 300/día; con remitente @gmail.com suele caer en spam)
EMAIL_PROVIDER=consola

# Solo para "gmail": la URL del Apps Script (termina en /exec) y la misma clave SECRETO del script
GMAIL_SCRIPT_URL=
GMAIL_SCRIPT_SECRET=

# Solo para "brevo":
EMAIL_FROM_NAME=Auto-Wealth
# El correo remitente que verificaste en Brevo
EMAIL_FROM_ADDRESS=tu.correo@gmail.com
# Brevo → tu nombre (arriba a la derecha) → SMTP & API → pestaña "API Keys"
BREVO_API_KEY=

# --- PANEL DE ADMINISTRACIÓN (descargar datos en Excel/CSV) -----------
# Usuario y contraseña para /admin. Si ADMIN_PASSWORD queda vacío, /admin se desactiva.
ADMIN_USER=admin
ADMIN_PASSWORD=

# --- SEGURIDAD DE DATOS FINANCIEROS ---------------------------------
# Clave para cifrar los datos financieros (64 caracteres). Genérala con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ¡IMPORTANTE! Guárdala en un lugar seguro: si se pierde, los datos cifrados
# no se pueden recuperar. Usa la MISMA clave en tu computador y en Render
# si comparten la misma base de datos.
DATA_ENCRYPTION_KEY=

# --- OPEN FINANCE ---------------------------------------------------
# "simulado" = bancos de prueba con datos ficticios (prototipo)
OPEN_FINANCE_PROVIDER=simulado
# Meses que dura una autorización de Open Finance (1 a 24)
CONSENT_MONTHS=12
